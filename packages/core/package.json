{
  "name": "@nohello/core",
  "version": "0.1.0",
  "description": "Configurable #nohello detection, wait-timer, and tone-based nudge engine. Platform-agnostic — feed it messages, get back nudges to send.",
  "license": "MIT",
  "author": "Balajikumar Murugan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ji-in-loop/nohello.git",
    "directory": "packages/core"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@vitest/coverage-v8": "^2.1.9",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
